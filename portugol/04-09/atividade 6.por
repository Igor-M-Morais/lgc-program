/*Metros para centímetros
Leia uma distância em metros e transforme em centímetros.*/

programa {
  funcao inicio() {
    inteiro metros, centimetros
    escreva ("Digite a quantidade de metros: ")
    leia (metros)
    centimetros = metros * 100
    escreva ("o valor em centímetros é: " + centimetros)
  }
}
